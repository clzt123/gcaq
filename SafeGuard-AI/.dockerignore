# ==========================================
# SafeGuard-AI Docker 构建忽略文件
# ==========================================
# 减小构建上下文体积，防止敏感文件泄露

# Python 缓存与编译产物
__pycache__/
*.pyc
*.pyo
*.egg-info/
.eggs/
dist/
build/
*.egg

# Python 虚拟环境
venv/
.venv/
.env/
env/

# 环境变量（绝不能打入镜像！）
.env
.env.*
!.env.example

# Git 版本控制
.git/
.gitignore
.gitattributes

# Mock 测试数据（生产镜像不需要）
mock_data/images/
mock_data/*.json
mock_data/*.cypher
# 保留 mock_data/ 目录结构以防代码引用，但内含文件已排除

# 测试与脚本
tests/
scripts/

# 文档（减少镜像体积）
docs/
*.md
!CLAUDE.md

# IDE 与编辑器
.vscode/
.idea/
*.swp
*.swo
*~

# 日志文件
logs/
*.log

# 临时文件
tmp/
temp/
*.tmp

# Docker 相关
.dockerignore
Dockerfile
docker-compose*.yml

# Claude AI 相关
.claude/
.claudeignore

# 测试缓存
.pytest_cache/

# 系统文件（Windows/macOS）
Thumbs.db
.DS_Store

# 项目文档截图等大文件
*.png
*.jpg
*.jpeg
*.mp4
*.pdf
*.gif
