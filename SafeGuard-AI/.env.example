# =========================
# SafeGuard-AI 环境变量模板
# 使用方式: 复制为 .env 并填入真实值
#   cp .env.example .env
# =========================

# 大模型配置（DeepSeek / OpenAI 兼容接口）
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL_NAME=deepseek-chat

# Neo4j 图数据库配置
NEO4J_URI=bolt://localhost:17687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password
# NEO4J_USE_MOCK=true   # 开发环境默认注释 = Mock 模式；生产环境设为 false
NEO4J_BOLT_PORT=17687

# Redis 短期记忆配置
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379
REDIS_MAXMEMORY=256mb

# Milvus 向量库配置
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_GRPC_PORT=19530
MILVUS_HTTP_PORT=9091
MILVUS_MEMORY_COLLECTION_NAME=expert_memory

# 视觉大模型配置（阿里云 DashScope / Qwen-VL 多模态识别）
DASHSCOPE_API_KEY=your-dashscope-api-key-here
DASHSCOPE_VL_MODEL=qwen-vl-max-latest
DASHSCOPE_VL_TIMEOUT=60.0

# LangSmith 可观测性配置（LangChain/LangGraph 追踪与调试）
# 注册地址: https://smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=SafeGuard-AI
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com   # 默认值，无需修改
